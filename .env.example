# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL_PROVIDER: Backend email provider for Welcome Mail Employee (e.g. resend, sendgrid, postmark, smtp, or webhook)
EMAIL_PROVIDER=

# EMAIL_API_KEY: Secret API key for the chosen email provider (never exposed to frontend)
EMAIL_API_KEY=

# EMAIL_FROM_ADDRESS: Verified sender email address
EMAIL_FROM_ADDRESS=admissions@codeneksa.com

# EMAIL_FROM_NAME: Display name of the sender
EMAIL_FROM_NAME=Codeneksa Admissions

# EMAIL_REPLY_TO: Optional reply-to address
EMAIL_REPLY_TO=support@codeneksa.com

# EMAIL_TEST_RECIPIENT: Default recipient address for test emails
EMAIL_TEST_RECIPIENT=operations-test@codeneksa.com
